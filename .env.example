# Required
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
OPENAI_API_KEY=

# Optional
# OPENAI_MODEL=gpt-5
# ALLOWED_EMAIL=kiril@qcgrowth.com      (defaults to this)
# CRON_SECRET=                          (only enforced when set)
# BRIEF_TOKEN=                          (required only to enable /api/brief for the Grok bot)
# STRIPE_WEBHOOK_SECRET=                (only if you register the Stripe webhook; daily cron works without it)
# SAMPLE_DATA=1                         (render built-in sample data, no DB)
